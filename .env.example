# Serverless Framework v4 loads .env.<stage> for the stage supplied to a
# deployment command, such as .env.test or .env.prd. An already-set shell or
# process environment variable takes precedence over the stage dotenv value.
PORT=8080
WASABI_SERVICE_URL=s3.example.com
WASABI_ACCESS_KEY_ID=replace-with-wasabi-access-key-id
WASABI_SECRET_ACCESS_KEY=replace-with-wasabi-secret-access-key
MONGODB_ATLAS_URI=mongodb+srv://cluster.example.mongodb.net/wasabi-drive
MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4

# Microsoft Entra ID API access-token validation (required)
ENTRA_TENANT_ID=replace-with-entra-tenant-id
ENTRA_API_CLIENT_ID=replace-with-api-app-registration-client-id
ENTRA_REQUIRED_SCOPE=WasabiDrive.Access
ENTRA_TRUSTED_USER_OBJECT_IDS=replace-with-entra-user-object-id
