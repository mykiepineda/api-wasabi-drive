# Serverless Framework v4 loads .env.<stage> for the stage supplied to a
# deployment command, such as .env.test or .env.prd. An already-set shell or
# process environment variable takes precedence over the stage dotenv value.
PORT=8080
WASABI_SERVICE_URL=https://s3.ap-northeast-1.wasabisys.com
WASABI_REGION=ap-northeast-1
WASABI_ACCESS_KEY_ID=replace-with-wasabi-access-key-id
WASABI_SECRET_ACCESS_KEY=replace-with-wasabi-secret-access-key
WASABI_INTERNAL_BUCKETS=replace-with-internal-derived-buckets

# Optional thumbnail access URL enrichment. Both modes are disabled by default.
THUMBNAIL_API_ENABLED=false
THUMBNAIL_API_SOURCE_BUCKET=replace-with-source-bucket
THUMBNAIL_API_SOURCE_REGION=ap-northeast-1
THUMBNAIL_API_SOURCE_PREFIX=replace-with-private-prefix/
THUMBNAIL_API_DERIVED_BUCKET=replace-with-derived-bucket
THUMBNAIL_API_DERIVED_REGION=ap-southeast-1
THUMBNAIL_API_ALLOWED_KEYS=
THUMBNAIL_API_READ_ACCESS_KEY_ID=replace-with-derived-read-access-key-id
THUMBNAIL_API_READ_SECRET_ACCESS_KEY=replace-with-derived-read-secret-access-key
THUMBNAIL_API_URL_TTL_SECONDS=3600

# Optional deterministic v2 thumbnail access URLs. Disabled by default.
THUMBNAIL_API_V2_ENABLED=false
THUMBNAIL_API_V2_SOURCE_BUCKET=replace-with-sydney-source-bucket
THUMBNAIL_API_V2_SOURCE_REGION=ap-southeast-2
THUMBNAIL_API_V2_SOURCE_PREFIX=replace-with-private-prefix/
# Optional explicit whole-bucket opt-in. Leave absent/empty to use the legacy
# single-bucket/prefix variables above. Example:
# THUMBNAIL_API_V2_SOURCE_BUCKETS_JSON=[{"bucket":"synthetic-photos","region":"ap-southeast-2"}]
THUMBNAIL_API_V2_SOURCE_BUCKETS_JSON=
# Stage caller explicitly supplies protected/excluded bucket names; no naming guesses.
THUMBNAIL_API_V2_EXCLUDED_BUCKETS_JSON=
# Keep both thumbnail modes disabled locally unless synthetic/mock values are
# intentionally configured. Stage values belong in protected GitHub Environments.

# Microsoft Entra ID API access-token validation (required)
ENTRA_TENANT_ID=replace-with-entra-tenant-id
ENTRA_API_CLIENT_ID=replace-with-api-app-registration-client-id
ENTRA_REQUIRED_SCOPE=WasabiDrive.Access
ENTRA_TRUSTED_USER_OBJECT_IDS=replace-with-entra-user-object-id

# Local one-object thumbnail pilot; TEST-only credentials and buckets.
# These are separate from the Express API's WASABI_* credentials above.
THUMBNAIL_PILOT_STAGE=test
THUMBNAIL_TEST_SOURCE_BUCKET=replace-with-test-source-bucket
THUMBNAIL_TEST_DERIVED_BUCKET=replace-with-test-thumbnail-bucket
THUMBNAIL_TEST_DERIVED_REGION=ap-southeast-1
# Wasabi's conditional-write fix is deployed in Singapore but incomplete in
# Sydney. Singapore was verified for the B1 TEST pilot; do not generalize this
# result to other Wasabi regions.
THUMBNAIL_TEST_WASABI_ACCESS_KEY_ID=replace-with-least-privilege-test-access-key
THUMBNAIL_TEST_WASABI_SECRET_ACCESS_KEY=replace-with-least-privilege-test-secret-key
