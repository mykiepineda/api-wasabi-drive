meta {
  name: Create user
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "{{userName}}",
    "password": "{{userPassword}}"
  }
}

script:post-response {
  bru.setVar("userId", res.body.insertedId);
}

tests {
  test("creates a user", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("acknowledged", true);
    expect(res.body).to.have.property("insertedId");
  });
}