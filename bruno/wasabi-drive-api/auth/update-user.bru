meta {
  name: Update user
  type: http
  seq: 5
  tags: [
    mutating
    known-defect
  ]
}

patch {
  url: {{baseUrl}}/auth/users/{{userId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "{{userName}}",
    "password": "{{userPassword}}"
  }
}

tests {
  test("updates a user", function() {
    expect(res.status).to.equal(200);
  });
}