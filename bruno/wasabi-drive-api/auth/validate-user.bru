meta {
  name: Validate user credentials
  type: http
  seq: 3
  tags: [
    depends-on-create-user
  ]
}

post {
  url: {{baseUrl}}/auth/users/validate
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "{{userName}}",
    "password": "{{userPassword}}"
  }
}

tests {
  test("validates user credentials", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("isAuthenticated");
    expect(res.body.isAuthenticated).to.equal(true);
    expect(res.body).to.have.property("token");
  });
}