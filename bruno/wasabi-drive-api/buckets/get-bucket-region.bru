meta {
  name: Get bucket region
  type: http
  seq: 2
  tags: [
    regression
  ]
}

get {
  url: {{baseUrl}}/buckets/{{bucketName}}/region
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("returns bucket region metadata", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("region");
  });
}