meta {
  name: Reject invalid MaxKeys
  type: http
  seq: 5
  tags: [
    regression
  ]
}

get {
  url: {{baseUrl}}/buckets/{{bucketName}}/objects{{objectPrefix}}?MaxKeys=0
  body: none
  auth: none
}

params:query {
  MaxKeys: 0
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("rejects an out-of-range MaxKeys value", function() {
    expect(res.status).to.equal(400);
    expect(res.body).to.deep.equal({
      error: "MaxKeys must be an integer between 1 and 1000."
    });
  });
}