meta {
  name: List bucket objects next page
  type: http
  seq: 4
  tags: [
    regression
  ]
}

get {
  url: {{baseUrl}}/buckets/{{bucketName}}/objects{{objectPrefix}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

query {
  MaxKeys: 25
  ContinuationToken: {{continuationToken}}
}

tests {
  test("returns the next object listing page", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("TotalKeyCount");
  });
}