meta {
  name: List bucket objects
  type: http
  seq: 3
  tags: [
    regression
  ]
}

get {
  url: {{baseUrl}}/buckets/{{bucketName}}/objects{{objectPrefix}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

query {
  MaxKeys: 25
}

tests {
  test("returns an object listing with a total count", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("TotalKeyCount");
  });
}