meta {
  name: Rejects requests without an access token
  type: http
  seq: 5
  tags: [
    regression
    deployment-smoke
  ]
}

get {
  url: {{baseUrl}}/buckets/
  body: none
  auth: none
}

tests {
  test("returns 401 when the access token is missing", function() {
    expect(res.status).to.equal(401);
    expect(res.body).to.deep.equal({ error: "Unauthorized" });
  });
}