vars {
  baseUrl: {{process.env.BASE_URL}}
  bucketName: {{process.env.INTEGRATION_BUCKET_NAME}}
  objectPrefix: /
  continuationToken: {{process.env.INTEGRATION_CONTINUATION_TOKEN}}
  accessToken: {{process.env.INTEGRATION_ACCESS_TOKEN}}
  userId: replace-at-runtime
  userName: {{process.env.INTEGRATION_USER_NAME}}
  userPassword: {{process.env.INTEGRATION_USER_PASSWORD}}
}