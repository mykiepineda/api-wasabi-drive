meta {
  name: Health check
  type: http
  seq: 1
  tags: [
    deployment-smoke
  ]
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

tests {
  test("returns the health status", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.deep.equal({ status: "ok" });
  });
}
